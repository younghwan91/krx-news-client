# Redis — 로컬 실행 기준. `docker compose` 는 서비스 이름(redis://redis:6379)으로 자동 덮어쓴다.
REDIS_URL=redis://localhost:6379

# DART Open API (https://opendart.fss.or.kr 에서 발급)
DART_API_KEY=

# 크롤링 주기 (초)
CRAWL_INTERVAL_NEWS=300
CRAWL_INTERVAL_DISCLOSURE=60

# 로그 레벨
LOG_LEVEL=INFO

# 서버 설정
HOST=0.0.0.0
PORT=8000
WORKERS=1
